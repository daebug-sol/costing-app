generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String   @id @default(cuid())
  clerkOrgId        String?  @unique
  name              String
  slug              String   @unique
  /** Operator-managed: special clients keep AHU; new orgs default off. */
  ahuModuleEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())

  members           OrganizationMember[]
  settings          AppSettings?
  materials         MaterialPrice[]
  profiles          ProfileData[]
  components        ComponentCatalog[]
  customDbTables    CustomDbTable[]
  projects          CostingProject[]
  quotations        Quotation[]
  databaseFolders   DatabaseFolder[]
  customers         Customer[]
  documentSequences DocumentSequence[]
  salesOrders       SalesOrder[]
  deliveryOrders    DeliveryOrder[]
  invoices          Invoice[]
  payments          Payment[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model AppSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName        String       @default("PT Thermal True Indonesia")
  companyAddress     String       @default("")
  companyPhone       String       @default("")
  companyEmail       String       @default("")
  companyLogo        String?
  forexUSD           Float        @default(15800)
  forexEUR           Float        @default(17200)
  forexRM            Float        @default(3500)
  forexSGD           Float        @default(11700)
  defaultOverhead    Float        @default(5.0)
  defaultContingency Float        @default(3.0)
  defaultMargin      Float        @default(20.0)
  defaultEskalasi    Float        @default(0.0)
  defaultAsuransi    Float        @default(0.0)
  defaultMobilisasi  Float        @default(0.0)
  ppnRate            Float        @default(11.0)
  paymentTerms       String       @default("DP 50%, balance CBD")
  deliveryTerms      String       @default("Ex-work Cikarang")
  warrantyTerms      String       @default("12 months since delivery")
  validityDays       Int          @default(14)
  termsConditions    String       @default("")
  presetSignedByName String       @default("")
  presetCheckedByName String      @default("")
  presetApprovedByName String     @default("")
  presetTtdPrepared  String?
  presetTtdReviewed  String?
  presetTtdApproved  String?
  onboardingComplete Boolean      @default(false)
  /** Document number prefixes — format {PREFIX}-{YYYYMM}-{seq4}. */
  quoPrefix          String       @default("QT")
  soPrefix           String       @default("SO")
  doPrefix           String       @default("SJ")
  invPrefix          String       @default("INV")
  payPrefix          String       @default("PAY")
  updatedAt          DateTime     @updatedAt
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  company        String       @default("")
  address        String       @default("")
  attn           String       @default("")
  phone          String       @default("")
  email          String?
  npwp           String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]

  @@index([organizationId, name])
  @@index([organizationId])
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /** QUO | SO | DO | INV | PAY */
  docType        String
  /** YYYYMM */
  period         String
  lastNumber     Int          @default(0)

  @@unique([organizationId, docType, period])
  @@index([organizationId])
}

/** Folder tree for /database — scope `custom` or `ahu`. */
model DatabaseFolder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customTables CustomDbTable[]
  ahuFiles     AhuDatasetFile[]

  @@index([organizationId, scope, sortOrder])
}

/** AHU dataset file (materials / profiles / components) under a folder. */
model AhuDatasetFile {
  id        String         @id @default(cuid())
  folderId  String
  folder    DatabaseFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  sortOrder Int            @default(0)
  materials  MaterialPrice[]
  profiles   ProfileData[]
  components ComponentCatalog[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([folderId, kind])
  @@index([folderId, sortOrder])
}

model MaterialPrice {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datasetFileId  String?
  datasetFile    AhuDatasetFile? @relation(fields: [datasetFileId], references: [id], onDelete: Cascade)
  code           String
  name           String
  category       String
  density        Float
  pricePerKg     Float
  currency       String          @default("IDR")
  unit           String          @default("kg")
  notes          String?
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  @@unique([organizationId, code])
  @@index([datasetFileId])
  @@index([organizationId])
}

model ProfileData {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datasetFileId  String?
  datasetFile    AhuDatasetFile? @relation(fields: [datasetFileId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           String
  weightPerM     Float
  pricePerM      Float
  panelThick     Int?
  notes          String?
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  @@unique([organizationId, code])
  @@index([datasetFileId])
  @@index([organizationId])
}

model ComponentCatalog {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datasetFileId  String?
  datasetFile    AhuDatasetFile? @relation(fields: [datasetFileId], references: [id], onDelete: Cascade)
  code           String
  name           String
  category       String
  subcategory    String?
  brand          String?
  model          String?
  spec           String?
  unitPrice      Float
  currency       String          @default("IDR")
  unit           String          @default("pcs")
  moq            Int?
  leadTimeDays   Int?
  supplier       String?
  notes          String?
  updatedAt      DateTime        @updatedAt
  createdAt      DateTime        @default(now())

  @@unique([organizationId, code])
  @@index([datasetFileId])
  @@index([organizationId])
}

model CostingProject {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  status         String           @default("draft")
  qty            Int              @default(1)
  overhead       Float            @default(5.0)
  contingency    Float            @default(3.0)
  eskalasi       Float            @default(0.0)
  asuransi       Float            @default(0.0)
  mobilisasi     Float            @default(0.0)
  margin         Float            @default(20.0)
  /** Extra markup % applied after margin stack (pct first, then Amt). */
  priceAdjustmentPct Float        @default(0.0)
  /** Extra absolute IDR bump after margin + pct adjustment. */
  priceAdjustmentAmt Float        @default(0.0)
  totalHPP       Float            @default(0.0)
  totalSelling   Float            @default(0.0)
  notes          String?
  segments       CostingSegment[]
  quotations     Quotation[]
  quotationItems QuotationItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
}

/** Satu baris costing dalam proyek: AHU (kalkulasi dimensi) atau manual (DB). */
model CostingSegment {
  id          String   @id @default(cuid())
  projectId   String
  project     CostingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  title       String   @default("")
  sortOrder   Int      @default(0)
  subtotal    Float    @default(0.0)
  ahuModel    String?
  ahuRef      String?
  flowCMH     Float?
  qty         Int      @default(1)
  dimH        Float?
  dimW        Float?
  dimD        Float?
  profileType String?
  ahuRecalcParams Json?
  sections          CostingSection[]
  manualGroups      ManualCostingGroup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ManualCostingGroup {
  id        String         @id @default(cuid())
  segmentId String
  segment   CostingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int            @default(0)
  subtotal  Float          @default(0.0)
  items     ManualCostingItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([segmentId])
}

model ManualCostingItem {
  id             String             @id @default(cuid())
  groupId        String
  group          ManualCostingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder      Int                @default(0)
  sourceType     String
  sourceId       String
  code           String
  name           String
  category       String
  uom            String
  qty            Float              @default(1)
  basePrice      Float
  overridePrice  Float?
  effectivePrice Float
  wasteFactor    Float              @default(1.0)
  subtotal       Float              @default(0.0)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([groupId])
}

model CustomDbTable {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderId       String?
  folder         DatabaseFolder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name           String           @default("Custom Database")
  columns        CustomDbColumn[]
  rows           CustomDbRow[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([folderId])
  @@index([organizationId])
}

model CustomDbColumn {
  id        String    @id
  tableId   String
  table     CustomDbTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  header    String
  sortOrder Int
  locked    Boolean   @default(false)
  kind      String    @default("dynamic")
  cells     CustomDbCell[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tableId, header])
  @@unique([tableId, sortOrder])
  @@index([tableId])
}

model CustomDbRow {
  id        String    @id @default(cuid())
  tableId   String
  table     CustomDbTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sortOrder Int
  cells     CustomDbCell[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tableId, sortOrder])
  @@index([tableId])
}

model CustomDbCell {
  id            String   @id @default(cuid())
  rowId         String
  row           CustomDbRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  columnId      String
  column        CustomDbColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  rawValue      String?
  computedValue Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([rowId, columnId])
  @@index([columnId])
}

model CostingSection {
  id        String         @id @default(cuid())
  segmentId String
  segment   CostingSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  category  String
  sortOrder Int            @default(0)
  /** Calculated from line items (Hitung ulang / qty override). */
  subtotal  Float          @default(0.0)
  /** Optional category selling override (IDR). Null = use calculated `subtotal`. */
  overrideSubtotal Float?
  lineItems CostingLineItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([segmentId])
}

model CostingLineItem {
  id           String         @id @default(cuid())
  sectionId    String
  section      CostingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder    Int            @default(0)
  description  String
  uom          String
  qty          Float
  qtyFormula   String?
  isOverride   Boolean        @default(false)
  unitPrice    Float
  currency     String         @default("IDR")
  wasteFactor  Float          @default(1.0)
  subtotal     Float
  componentRef String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Quotation {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         CostingProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  status          String          @default("draft")
  noSurat         String?
  tanggal         DateTime        @default(now())
  perihal         String?
  clientName      String?
  clientCompany   String?
  salesman        String?
  clientAddress   String?
  clientAttn      String?
  clientPhone     String?
  projectLocation String?
  ourRef          String?
  yourRef         String?
  discount        Float           @default(0.0)
  discountEnabled Boolean         @default(true)
  ppn             Float           @default(11.0)
  ppnEnabled      Boolean         @default(true)
  pphEnabled      Boolean         @default(false)
  pphRate         Float           @default(0.0)
  totalBeforeDisc Float           @default(0.0)
  totalAfterDisc  Float           @default(0.0)
  totalPPN        Float           @default(0.0)
  totalPPH        Float           @default(0.0)
  grandTotal      Float           @default(0.0)
  paymentTerms    String?
  deliveryTerms   String?
  warrantyTerms   String?
  validityDays    Int             @default(14)
  termsConditions String?
  introText       String?
  notes           String?
  ttdPrepared     String?
  ttdReviewed     String?
  ttdApproved     String?
  stampPath       String?
  sentAt          DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  revision        Int             @default(0)
  revisionOfId    String?
  revisionOf      Quotation?      @relation("QuotationRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions       Quotation[]     @relation("QuotationRevision")
  convertedSoId   String?
  convertedSo     SalesOrder?     @relation("QuotationConvertedSo", fields: [convertedSoId], references: [id], onDelete: SetNull)
  salesOrders     SalesOrder[]    @relation("SalesOrderFromQuotation")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([convertedSoId])
}

model SalesOrder {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  soNumber         String
  quotationId      String?
  quotation        Quotation?       @relation("SalesOrderFromQuotation", fields: [quotationId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tanggal          DateTime         @default(now())
  poNumber         String?
  status           String           @default("open")
  subtotal         Float            @default(0.0)
  discount         Float            @default(0.0)
  ppn              Float            @default(0.0)
  grandTotal       Float            @default(0.0)
  paymentTerms     String?
  deliveryTerms    String?
  notes            String?
  /** Snapshot client fields for PDF */
  clientName       String?
  clientCompany    String?
  clientAddress    String?
  clientAttn       String?
  clientPhone      String?
  items            SalesOrderItem[]
  deliveries       DeliveryOrder[]
  invoices         Invoice[]
  convertedFromQuos Quotation[]     @relation("QuotationConvertedSo")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, soNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([quotationId])
  @@index([status])
}

model SalesOrderItem {
  id              String         @id @default(cuid())
  soId            String
  salesOrder      SalesOrder     @relation(fields: [soId], references: [id], onDelete: Cascade)
  quotationItemId String?
  projectId       String?
  description     String
  spec            String?
  qty             Float          @default(1)
  uom             String         @default("Unit")
  unitPrice       Float
  totalPrice      Float
  deliveredQty    Float          @default(0)
  deliveryItems   DeliveryItem[]
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([soId])
}

model DeliveryOrder {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doNumber        String
  salesOrderId    String
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  tanggal         DateTime       @default(now())
  status          String         @default("draft")
  shippingAddress String?
  notes           String?
  items           DeliveryItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, doNumber])
  @@index([organizationId])
  @@index([salesOrderId])
}

model DeliveryItem {
  id           String         @id @default(cuid())
  doId         String
  deliveryOrder DeliveryOrder @relation(fields: [doId], references: [id], onDelete: Cascade)
  soItemId     String
  soItem       SalesOrderItem @relation(fields: [soItemId], references: [id], onDelete: Restrict)
  qtyDelivered Float
  createdAt    DateTime       @default(now())

  @@index([doId])
  @@index([soItemId])
}

model Invoice {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invNumber      String?
  salesOrderId   String?
  salesOrder     SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tanggal        DateTime            @default(now())
  dueDate        DateTime?
  /** dp | progress | final */
  kind           String              @default("final")
  subtotal       Float               @default(0.0)
  discountPct    Float               @default(0.0)
  discountAmt    Float               @default(0.0)
  dpp            Float               @default(0.0)
  ppn            Float               @default(0.0)
  pph            Float               @default(0.0)
  grandTotal     Float               @default(0.0)
  paidTotal      Float               @default(0.0)
  status         String              @default("draft")
  notes          String?
  voidReason     String?
  clientName     String?
  clientCompany  String?
  clientAddress  String?
  clientAttn     String?
  clientPhone    String?
  items          InvoiceItem[]
  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invId       String
  invoice     Invoice  @relation(fields: [invId], references: [id], onDelete: Cascade)
  description String
  qty         Float    @default(1)
  uom         String   @default("Unit")
  unitPrice   Float
  totalPrice  Float
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([invId])
}

model Payment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payNumber      String
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tanggal        DateTime            @default(now())
  method         String              @default("transfer")
  reference      String?
  amount         Float
  status         String              @default("posted")
  notes          String?
  allocations    PaymentAllocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, payNumber])
  @@index([organizationId])
  @@index([customerId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Float

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model QuotationItem {
  id            String         @id @default(cuid())
  quotationId   String
  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  projectId     String
  project       CostingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sortOrder     Int            @default(0)
  description   String
  spec          String?
  qty           Int            @default(1)
  uom           String         @default("Unit")
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([quotationId])
  @@index([projectId])
}
